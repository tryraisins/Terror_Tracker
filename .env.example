# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nigeria-attack-tracker?retryWrites=true&w=majority

# Free source-led collection controls. No AI API key is required.
# Must be "true" in the Netlify env for the daily scheduled scan to run.
FREE_SOURCE_INGEST_ENABLED=true
# Trailing discovery window relative to each cron run (48h).
FREE_SOURCE_MAX_ARTICLE_AGE_HOURS=48
FREE_SOURCE_MAX_INCIDENT_AGE_DAYS=2
FREE_SOURCE_MAX_ITEMS_PER_FEED=12
SOURCE_FETCH_TIMEOUT_MS=8000

# Optional multi-engine discovery. DuckDuckGo HTML works without a key.
BRAVE_SEARCH_API_KEY=
NEWS_DISCOVERY_PROVIDER=auto
NEWS_DISCOVERY_ENABLE_BING=false
NEWS_DISCOVERY_MIN_DELAY_MS=3000
NEWS_RESOLVER_TITLE_SEARCH=false
NEWS_RESOLVER_SEARCH_PROVIDER=auto

# Search-led discovery runs every scheduled slot, with seven-day daily coverage.
# Sunday catch-up uses 336 hours and SEARCH_FRESHNESS=month in GitHub Actions.
INCIDENT_LOOKBACK_HOURS=168
SEARCH_PUBLICATION_MAX_AGE_HOURS=168
SEARCH_RESULTS_PER_QUERY=10
STATE_SCAN_CONCURRENCY=3
BRAVE_SEARCH_MAX_CALLS_PER_RUN=40
# Recency window passed to search engines: day | week | month.
SEARCH_FRESHNESS=week

# Supplemental registered publisher feeds use the same source admission gates.
SEARCH_LED_FEEDS_ENABLED=true
# Retry due review leads through extraction + admission + deduplication.
# Attempts are capped at three per source/kind; conflicts remain for admin review.
INCIDENT_REVIEW_RETRY_LIMIT=5
# Public scan health warns when no complete coverage run exists within 18 hours.
SCAN_HEALTH_STALE_HOURS=18

# Optional DeepSeek cleanup/confirmation pass over heuristic-cleared incidents.
# Runs only when DEEPSEEK_API_KEY is set; set DEEPSEEK_CLEANUP_ENABLED=false (or
# leave the key blank) to keep the daily scan fully free.
DEEPSEEK_CLEANUP_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=30000

# Default Admin Bootstrap (used only when no users exist)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_this_strong_password

# Cron Job Secret (set this to a strong random string, use the same in cron-job.org headers)
CRON_SECRET=your_cron_secret_here

# API Key for public endpoints
API_KEY=your_api_key_here

# JWT secret for admin auth
JWT_SECRET=replace_with_long_random_secret
# Optional: bump to invalidate existing sessions
JWT_SECRET_VERSION=1

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App URL (for CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin login CAPTCHA (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames configured on the Turnstile widget
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,terrortracker.tryraisins.dev

# Twitter/X Scraper Credentials (use a secondary/burner account — risk of ban)
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email@example.com
# Optional: paste cookie JSON here after first successful login to avoid re-login
# TWITTER_COOKIES=
