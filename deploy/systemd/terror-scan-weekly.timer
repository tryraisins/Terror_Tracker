[Unit]
Description=Weekly catch-up slot (Sunday 14:00 UTC, fourteen-day window)

[Timer]
# Clear of the 11:00 and 23:00 daily slots: run-scan.sh holds a flock, so an
# overlapping slot exits 75 and raises a failure alert. Sunday is off-peak for
# DeepSeek pricing all day, so this slot needs no time change of its own.
OnCalendar=Sun 14:00:00 UTC
AccuracySec=1min
RandomizedDelaySec=60
Persistent=true
Unit=terror-scan-weekly.service

[Install]
WantedBy=timers.target
