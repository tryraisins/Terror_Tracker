[Unit]
Description=Terror Tracker search-led incident scan
Documentation=https://github.com/tryraisins/Terror_Tracker
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnFailure=terror-scan-alert.service

[Service]
Type=oneshot
WorkingDirectory=/srv/terror-tracker
ExecStart=/srv/terror-tracker/run-scan.sh
# A measured full run is about 22-25 minutes (37 states, 13 batches, ~750
# article fetches); the ceiling exists so a wedged run cannot hold the lock
# into the next slot.
TimeoutStartSec=5400
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
