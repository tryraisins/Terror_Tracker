[Unit]
Description=Terror Tracker scan cadence (replaces the GitHub Actions schedule)

[Timer]
# The four daily slots the workflow used, pinned to UTC so the host's
# Europe/Berlin clock and its DST shift cannot move them.
OnCalendar=*-*-* 06,09,12,15:30 UTC
AccuracySec=1min
RandomizedDelaySec=60
# Catch up after downtime instead of silently skipping a slot.
Persistent=true
Unit=terror-scan.service

[Install]
WantedBy=timers.target
