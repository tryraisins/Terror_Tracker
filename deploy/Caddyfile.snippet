# Caddy on the host, serving Cloudflare-proxied hostnames.
#
# This box runs Caddy 2.6.2. The `trusted_proxies` global option needs Caddy 2.7+,
# so it is deliberately absent: on 2.6 X-Forwarded-For keeps whatever the last
# hop sent. That is acceptable here because the app reads `cf-connecting-ip`
# directly (see getClientIP in src/lib/security.ts). If Caddy is upgraded to 2.7+,
# add the Cloudflare ranges from https://www.cloudflare.com/ips/ at the top:
#
#   {
#       trusted_proxies static 173.245.48.0/20 103.21.244.0/22 ...
#   }
#
# TLS: Cloudflare terminates the public certificate and connects to this origin
# with SSL mode Full (strict). TLS-ALPN-01 cannot validate through a proxy, so it
# is disabled and Caddy issues through HTTP-01, which Cloudflare forwards to :80.
# The domain must already resolve to this box before a block is added, otherwise
# every validation attempt fails and Let's Encrypt locks the hostname for an hour
# after five failures. Add one block per hostname, in this order:
#   1. new.tryraisins.dev        (rehearsal, while terrortracker is still on Netlify)
#   2. terrortracker.tryraisins.dev (only once its DNS points here)
#
# Merge into /etc/caddy/Caddyfile, keep the existing sloplens-api block, then:
#   caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   systemctl reload caddy

sloplens-api.tryraisins.dev {
	reverse_proxy 127.0.0.1:4310
}

# Rehearsal hostname. Delete this block and its DNS record once
# terrortracker.tryraisins.dev has been live on this box for a week.
new.tryraisins.dev {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}

terrortracker.tryraisins.dev {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}
