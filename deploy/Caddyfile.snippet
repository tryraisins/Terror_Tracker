# Caddy on the box, serving Cloudflare-proxied hostnames.
#
# 1. Add the global block below to the TOP of /etc/caddy/Caddyfile (sloplens-api
#    already lives there, so merge rather than overwrite).
# 2. Add one site block per hostname.
# 3. sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# TLS with Cloudflare proxying (SSL mode must be Full (strict)):
#   - Cloudflare terminates the public certificate and connects to :443 here.
#   - TLS-ALPN-01 cannot work through a proxy, so it is disabled below and Caddy
#     issues via HTTP-01, which Cloudflare forwards to :80 normally.
#   - Set the records to proxied only after the first certificate exists, or
#     expect a brief 526 while it issues.
#
# Alternative, if you prefer not to rely on ACME through the proxy: create a
# Cloudflare Origin Certificate in the dashboard (SSL/TLS > Origin Server)
# covering both hostnames, install it at /etc/caddy/certs/, and replace the
# `tls { issuer ... }` block with:
#     tls /etc/caddy/certs/terrortracker-origin.pem /etc/caddy/certs/terrortracker-origin.key

{
	servers {
		# Cloudflare edge ranges, so X-Forwarded-For carries the real client and
		# not the Cloudflare colo. The app reads CF-Connecting-IP directly; this
		# keeps Caddy's own logs honest too.
		# Refresh from https://www.cloudflare.com/ips/ when it changes.
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

terrortracker.tryraisins.dev {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}

# Temporary rehearsal hostname. Delete this block and its DNS record once the
# production hostname has been live for a week.
new.tryraisins.dev {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}
