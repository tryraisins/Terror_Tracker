# Runtime environment for the Next.js server.
# Installed at /etc/terror-tracker/app.env, owned by root, mode 600.
# Copy the values from the Netlify dashboard, not from `netlify env:list`:
# context-scoped variables (the TURNSTILE_* set) do not appear in the CLI output.
# Owners: root:root   Mode: 600

NODE_ENV=production

# --- database -----------------------------------------------------------------
MONGODB_URI=

# --- public origin ------------------------------------------------------------
# Drives the CSRF origin check and the CORS allowlist. Must match the URL the
# browser uses, including the scheme.
#   staging:     https://new.tryraisins.dev
#   production:  https://terrortracker.tryraisins.dev
NEXT_PUBLIC_APP_URL=https://terrortracker.tryraisins.dev

# --- session ------------------------------------------------------------------
JWT_SECRET=
JWT_SECRET_VERSION=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

# --- rate limiting ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Turnstile ----------------------------------------------------------------
# The site key is a build-time value and is passed as a Docker build arg, not
# read here. Both hostnames must be listed or admin login is rejected as invalid.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=terrortracker.tryraisins.dev,new.tryraisins.dev

# --- internal API -----------------------------------------------------------------
API_KEY=
CRON_SECRET=

# --- feature switches carried over from Netlify -------------------------------
FREE_SOURCE_INGEST_ENABLED=false
DEEPSEEK_CLEANUP_ENABLED=true
DEEPSEEK_MODEL=deepseek-chat
SOURCE_FETCH_TIMEOUT_MS=10000

# --- legacy audit-only credentials, only needed if those scripts run here -----
GEMINI_MODEL=
GEMINI_DEDUP_MODEL=
GEMINI_TIMEOUT_MS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
