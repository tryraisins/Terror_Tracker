# Environment for the scheduled scan container and the alert scripts.
# Installed at /etc/terror-tracker/scan.env, owned by root, mode 600.
# Values match what .github/workflows/daily-scan.yml used to inject inline, so
# scan behaviour is unchanged by the move.
# Owners: root:root   Mode: 600

# --- pipeline -----------------------------------------------------------------
MONGODB_URI=
BRAVE_SEARCH_API_KEY=
DEEPSEEK_API_KEY=

DEEPSEEK_CLEANUP_ENABLED=true
DEEPSEEK_DUPLICATE_CHECK_ENABLED=true
DEEPSEEK_DUPLICATE_MAX_PAIRS=30
DEEPSEEK_MODEL=deepseek-chat

NEWS_DISCOVERY_ENABLE_BING=false
SEARCH_LED_FEEDS_ENABLED=true
STATE_SCAN_CONCURRENCY=3
BRAVE_SEARCH_MAX_CALLS_PER_RUN=40
BRAVE_SEARCH_MIN_DELAY_MS=5000
SEARCH_RESULTS_PER_QUERY=10
SOURCE_FETCH_TIMEOUT_MS=10000
SCAN_MAX_FETCH_FAILURES=3
SCAN_FETCH_FAILURE_TOLERANCE_RATIO=0.1

INCIDENT_REVIEW_RETRY_LIMIT=20
INCIDENT_REVIEW_MAX_ATTEMPTS=3

# Daily window. The Sunday catch-up runs `run-scan.sh --weekly`, which overrides
# these three to 336 / 336 / month, exactly as the workflow's computed values did.
INCIDENT_LOOKBACK_HOURS=168
SEARCH_PUBLICATION_MAX_AGE_HOURS=168
SEARCH_FRESHNESS=week
SCAN_SOURCE=server

# Written inside the container, mounted from /var/log/terror-tracker/reports on
# the host, which is also where run-scan.sh keeps the 30-day archive.
SCAN_REPORT_PATH=/var/log/terror-tracker/reports/latest.json

# --- alerting -----------------------------------------------------------------
# Used by scan-alert.sh and scan-deadman.sh. Never imported by the app.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Plain address only. The scripts add the display name themselves, because a
# value like "Terror Tracker <alerts@...>" cannot be read back from a data file
# without quoting rules getting in the way.
ALERT_EMAIL_FROM=alerts@tryraisins.dev

# Deadline before the dead-man check emails. The on-box dead-man compares the
# report file mtime; the app's stale banner uses the last COMPLETED ScanRun.
# The hourly off-box watchdog (.github/workflows/scan-watchdog.yml) uses the app's
# value, so the host-down case is covered by a check that does not live here.
SCAN_HEALTH_STALE_HOURS=18
